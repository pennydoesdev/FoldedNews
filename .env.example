# FoldedNews environment. Copy to .env and fill in. Never commit .env.
# Full variable catalogue (incl. later-stage secrets): docs/environment-variables.md

DB_NAME='foldednews'
DB_USER='foldednews'
DB_PASSWORD='database_password'
# DB_HOST='127.0.0.1'
# DB_PREFIX='wp_'
# DATABASE_URL='mysql://user:pass@127.0.0.1:3306/foldednews'

WP_ENV='development'
WP_HOME='http://foldednews.test'
WP_SITEURL="${WP_HOME}/wp"
# WP_ENVIRONMENT_TYPE='development'

# Active theme (slug under web/app/themes/).
WP_DEFAULT_THEME='foldednews'

# Used by the theme's Vite/Laravel plugin for dev asset URLs.
APP_URL="${WP_HOME}"

# Generate keys/salts here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# ── Stage 5: S3-compatible media offload (offload is inert until all set) ──
# S3_ENDPOINT='https://<account>.r2.cloudflarestorage.com'
# S3_REGION='auto'
# S3_BUCKET='foldednews-media'
# S3_KEY='...'
# S3_SECRET='...'
# CDN_URL='https://cdn.foldednews.com'
# S3_PATH_PREFIX='uploads'
# S3_FORCE_HTTPS=true
# S3_DELETE_LOCAL=false
# S3_SIGNED_URLS=false
# S3_CACHE_CONTROL='public, max-age=31536000, immutable'
# S3_MULTIPART_THRESHOLD=104857600

# ── Collaborative editor (Milkdown + Yjs). Optional — solo editing without it. ──
# FN_COLLAB_WS_URL='wss://collab.foldednews.com'   # y-websocket / Hocuspocus server

# ── Added in later stages (see docs/environment-variables.md) ─────────────
# Stage 10 Stripe billing:   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_* ...
# Stage 14 AI providers:     OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY ...
